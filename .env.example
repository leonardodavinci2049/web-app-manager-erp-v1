# ===================================================================
# Manager ERP - Environment variables example file
# Copy this file to ".env" and/or ".env.local" and fill in real values.
# Never commit real secrets.
# ===================================================================

# ===== APP =====
PORT=5581
NEXT_PUBLIC_APP_NAME=Manager ERP
NEXT_PUBLIC_SIDEBAR_TITLE=Manager - Administrative Panel
NEXT_PUBLIC_APP_URL=http://localhost:5581

# External images URL
NEXT_PUBLIC_EXTERNAL_PATH_IMAGES_URL=https://images.example.com

# ===== INFO COMPANY PUBLIC =====
NEXT_PUBLIC_COMPANY_NAME=Manager ERP
NEXT_PUBLIC_COMPANY_PHONE=+55 11 99999-9999
NEXT_PUBLIC_COMPANY_EMAIL=suporte@example.com
NEXT_PUBLIC_COMPANY_WHATSAPP=+55 11 99999-9999

# ===== METADATA =====
NEXT_PUBLIC_COMPANY_META_TITLE_MAIN=Manager ERP
NEXT_PUBLIC_COMPANY_META_TITLE_CAPTION="Gestão de cadastro de produtos, clientes, estoque e financeiro para pequenas e médias empresas."
NEXT_PUBLIC_COMPANY_META_DESCRIPTION="Sistema de gestão empresarial completo, ideal para pequenas e médias empresas que desejam otimizar seus processos e aumentar a eficiência."

# ===== INFO DEVELOPER =====
NEXT_PUBLIC_DEVELOPER_NAME=ExampleDev
NEXT_PUBLIC_DEVELOPER_URL=https://example.com

# ===== EXTERNAL API =====
EXTERNAL_API_MAIN_URL=http://localhost:5572/api
EXTERNAL_API_ASSETS_URL=http://localhost:5573/api

# ===== SYSTEM =====
APP_ID=1
STORE_ID=1

# ===== CONNECTION DATABASE (ADMIN) =====
DATABASE_ADMIN_USER="db_admin_user"
DATABASE_ADMIN_PASSWORD="change-me"
DATABASE_ADMIN_NAME="db_generalsystem"
DATABASE_ADMIN_HOST="10.0.0.210"
DATABASE_ADMIN_PORT=3306

# ===== CONNECTION DATABASE (APP) =====
DATABASE_USER="db_user"
DATABASE_PASSWORD="change-me"
DATABASE_NAME="db_generalsystem"
DATABASE_HOST="10.0.0.210"
DATABASE_PORT=3306

# ===== SECURITY =====
API_KEY=your-api-key-here

# ===== BETTER AUTH =====
BETTER_AUTH_SECRET=generate-a-random-32-char-secret
BETTER_AUTH_URL=http://localhost:5581

# ===== GITHUB OAUTH =====
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ===== GOOGLE OAUTH =====
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===== EMAIL (RESEND) =====
RESEND_API_KEY=re_your-resend-api-key
EMAIL_SENDER_NAME=Example App
EMAIL_SENDER_ADDRESS=contato@example.com

# ===== DEEPGRAM =====
DEEPGRAM_API_KEY=your-deepgram-api-key
